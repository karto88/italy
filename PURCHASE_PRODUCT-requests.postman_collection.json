{
  "info": {
    "name": "Keepz v2 — 10 Product Purchase (PURCHASE_PRODUCT, RETAIL)",
    "description": "დამოუკიდებელი collection — არ საჭიროებს merge-ს არსად. Auth: {{partnerToken}} — შენი 'auth — obtain a partner token' request-ი ავსებს ავტომატურად (dev environment description-ის მიხედვით). product.sku/label/merchantId — placeholder მონაცემებია, Keepz-ს კატალოგი არა აქვს, არსად არ მოწმდება (§7.2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{partnerToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "10 Product Purchase (§7.2, PURCHASE_PRODUCT, RETAIL) — happy path",
      "item": [
        {
          "name": "01 PARTNER start-operation (§7.2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"clientId\": \"{{clientId}}\",\n  \"channel\": \"RETAIL\",\n  \"operationType\": \"PURCHASE_PRODUCT\",\n  \"amount\": 4.00,\n  \"currency\": \"EUR\",\n  \"externalRef\": \"{{$timestamp}}-product\",\n  \"retailContext\": {\n    \"idShop\": \"{{idShop}}\",\n    \"admRegistrationCode\": \"PVR-TEST-1\",\n    \"idOperator\": \"OP-1\",\n    \"idTerminal\": \"TILL-2\"\n  },\n  \"product\": {\n    \"sku\": \"SKU-001\",\n    \"label\": \"Test Product\",\n    \"merchantId\": \"TEST-MERCHANT-01\"\n  }\n}"
            },
            "url": { "raw": "{{v2Base}}/operations/external/start-operation", "host": ["{{v2Base}}"], "path": ["operations", "external", "start-operation"] },
            "description": "happy path — PURCHASE_PRODUCT/RETAIL. §7.2. Decision Table #1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const jsonData = pm.response.json();",
                  "pm.test('resultCode is 200', () => pm.expect(jsonData.resultCode).to.eql(200));",
                  "pm.test('required keys present', () => {",
                  "  pm.expect(jsonData).to.have.property('operationId');",
                  "  pm.expect(jsonData).to.have.property('stage');",
                  "  pm.expect(jsonData).to.have.property('qrCodeUrl');",
                  "  pm.expect(jsonData).to.have.property('expiresAt');",
                  "});",
                  "pm.test('stage is GENERATED (not AWAITING_USER_LOGIN — 2.2.0 breaking change)', () => {",
                  "  pm.expect(jsonData.stage).to.eql('GENERATED');",
                  "});",
                  "pm.environment.set('operationId', jsonData.operationId);",
                  "pm.environment.set('productExternalRef', JSON.parse(pm.request.body.raw).externalRef);"
                ]
              }
            }
          ]
        },
